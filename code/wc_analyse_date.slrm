#!/bin/bash
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1G
#SBATCH --time=48:00:00
#SBATCH --job-name=wc_analyse

set -euo pipefail 2>/dev/null || set -eu

if [ $# -lt 1 ]; then
    echo "Usage: sbatch $(basename "$0") <acquisition_date> [additional python args]" >&2
    exit 1
fi

if [ -z "${SCRATCH:-}" ]; then
    echo "Environment variable SCRATCH is not defined." >&2
    exit 1
fi

acquisition_date="$1"
shift
python_args=("$@")

# ``sbatch`` preserves the directory from which the submission was issued.
# The start_wc_analyse.sh helper ``cd``s into the experiment directory before
# dispatching the individual date jobs, so we use ``SLURM_SUBMIT_DIR`` (or the
# current working directory as a fallback) as the experiment root.
experiment_dir="${SLURM_SUBMIT_DIR:-$PWD}"

if [ ! -d "$experiment_dir" ]; then
    echo "Experiment directory not found: $experiment_dir" >&2
    exit 1
fi

# The Python entry point may live either directly in ``experiment_dir`` or
# inside a ``code`` subdirectory (matching the repository layout).  Prefer the
# subdirectory when it exists, otherwise fall back to the root.
if [ -d "$experiment_dir/code" ]; then
    code_dir="$experiment_dir/code"
else
    code_dir="$experiment_dir"
fi

if [ ! -d "$code_dir" ]; then
    echo "Code directory not found: $code_dir" >&2
    exit 1
fi

# Load Anaconda module
module load Anaconda3/2023.10/miniconda-base-2023.10
eval "$($UIBK_CONDA_DIR/bin/conda shell.bash hook)"

conda activate wellcount6

cd "$code_dir"

python wc_analyze_experiment_HPC_multi.py \
    --experiment-dir "$experiment_dir" \
    --date "$acquisition_date" \
    "${python_args[@]}"
