#!/bin/bash
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=1G
#SBATCH --time=48:00:00
#SBATCH --job-name=wc_analyse

set -euo pipefail 2>/dev/null || set -eu

if [ $# -lt 1 ]; then
    echo "Usage: sbatch $(basename "$0") <experiment_name> [additional python args]" >&2
    exit 1
fi

if [ -z "${SCRATCH:-}" ]; then
    echo "Environment variable SCRATCH is not defined." >&2
    exit 1
fi

experiment_name="$1"
shift
python_args=("$@")

project_root="$SCRATCH/wellcounter"
code_dir="$project_root/code"
experiment_dir="$project_root/$experiment_name"

if [ ! -d "$experiment_dir" ]; then
    echo "Experiment directory not found: $experiment_dir" >&2
    exit 1
fi

if [ ! -d "$code_dir" ]; then
    echo "Code directory not found: $code_dir" >&2
    exit 1
fi

# Load Anaconda module
module load Anaconda3/2023.10/miniconda-base-2023.10
eval "$($UIBK_CONDA_DIR/bin/conda shell.bash hook)"

conda activate wellcount6

cd "$code_dir"

python wc_analyze_experiment_HPC_multi.py "$experiment_name" "${python_args[@]}"
